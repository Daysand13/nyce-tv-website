# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database ---
# Most hosts (Render, Railway, Supabase, Neon, Fly) give you one DATABASE_URL — paste it here.
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to "false" only if your provider's Postgres doesn't use SSL (e.g. a local install).
PGSSL=true

# --- Auth ---
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# --- Seeding (used only by `npm run seed`, not read by the running server) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_before_seeding

# --- Server ---
PORT=4000
# Comma-separated list of frontend URLs allowed to call this API. Use * only while testing.
FRONTEND_ORIGIN=*
# Where uploaded files are written. On most hosts this is NOT durable storage — see README.
UPLOAD_DIR=./uploads
