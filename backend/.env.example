# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database ---
# Most hosts (Render, Railway, Supabase, Neon, Fly) give you one DATABASE_URL — paste it here.
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to "false" only if your provider's Postgres doesn't use SSL (e.g. a local install).
PGSSL=true

# --- Auth ---
# Any long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# --- Seeding (used only by `npm run seed`, not read by the running server) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_before_seeding

# --- Server ---
PORT=4000
# Comma-separated list of frontend URLs allowed to call this API. Use * only while testing.
FRONTEND_ORIGIN=*
# Only used as a fallback when R2 (below) isn't configured — fine for local dev, NOT durable
# on most hosts in production (containers get rebuilt and wipe local files). See README §3.
UPLOAD_DIR=./uploads

# --- File storage (Cloudflare R2) ---
# Optional for local dev (falls back to local disk above if left blank) but REQUIRED for
# production — local disk uploads disappear whenever the host redeploys or recycles the
# container. All four must be set together to activate R2; see README §3 for setup steps.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The public URL your bucket serves files from — either the free https://pub-xxxx.r2.dev
# address R2 gives you, or your own connected custom domain (e.g. https://media.yourdomain.com).
R2_PUBLIC_URL=
